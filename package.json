{
	"name": "agent-x",
	"version": "0.1.0",
	"description": "Creates projects with a Next.js app and pi coding agents, and runs the agents",
	"type": "module",
	"bin": {
		"agentx": "dist/cli/agentx.js",
		"agent-x": "dist/cli/agentx.js"
	},
	"files": [
		"src/agent-runtime/pi-package",
		"dist",
		"templates"
	],
	"scripts": {
		"build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli/agentx.js', 0o755)\"",
		"check": "tsc --noEmit",
		"test": "pnpm run build && node --test \"test/*.test.mjs\""
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.5.2"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
