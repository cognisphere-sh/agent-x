{
	"name": "@cognisphere-sh/agentx",
	"version": "0.1.2",
	"description": "Creates projects with a Next.js app and pi coding agents, and runs the agents",
	"keywords": [
		"agents",
		"ai-agents",
		"pi",
		"coding-agent",
		"harness",
		"nextjs",
		"cli"
	],
	"license": "MIT",
	"author": "t0r0id",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cognisphere-sh/agentx.git"
	},
	"homepage": "https://github.com/cognisphere-sh/agentx#readme",
	"bugs": "https://github.com/cognisphere-sh/agentx/issues",
	"type": "module",
	"bin": {
		"agentx": "dist/cli/agentx.js",
		"agentx-browser": "dist/agent-runtime/browser/browser-command.js"
	},
	"types": "dist/index.d.ts",
	"files": [
		"src/agent-runtime/pi/pi-package",
		"src/agent-runtime/events/queue.ts",
		"src/agent-runtime/sqlite.ts",
		"src/agent-runtime/time-zone.ts",
		"src/agent-runtime/project-config.ts",
		"dist",
		"templates"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc && node -e \"for (const bin of ['dist/cli/agentx.js', 'dist/agent-runtime/browser/browser-command.js']) require('node:fs').chmodSync(bin, 0o755)\"",
		"check": "tsc --noEmit",
		"test": "pnpm run build && node --test \"test/*.test.mjs\""
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0",
		"agent-browser": "0.43.0",
		"croner": "11.0.0"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"packageManager": "pnpm@11.21.0"
}
