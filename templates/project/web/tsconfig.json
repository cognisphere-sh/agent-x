{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"plugins": [{ "name": "next" }],
		"allowJs": true,
		"incremental": true,
		"esModuleInterop": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		".next-a/types/**/*.ts",
		".next-a/dev/types/**/*.ts",
		".next-b/types/**/*.ts",
		".next-b/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
